---
import Card from '@components/ui/Card.astro';

/**
 * Props for a lint card component.
 *
 * @property id - Unique DOM ID for the card.
 */
type Props = {
	id: string;
};

const { id } = Astro.props;
---

<Card class="lint-card" role="group" {id}>
	<slot />
</Card>

<style is:global>
	.lint-card[role='group'] {
		display: flex;
		flex-direction: column;
		padding: var(--p-sm);
		background-color: var(--bg-3);
		color: var(--fg);
		white-space: nowrap;
	}

	.lint-card > astro-island {
		display: contents;
	}

	.lint-card header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--p-sm);
	}

	.lint-card .lint-kind {
		display: inline-flex;
		flex-direction: row;
		align-items: center;
		gap: var(--p-xs);
		margin-inline-start: var(--p-sm);
		font-family: var(--f-header);
		font-weight: var(--f-bold);
		color: var(--lint-card-color);
		transition-duration: var(--d-md);
	}

	.lint-card section {
		margin: var(--p-sm);
	}

	.lint-card svg {
		width: 1em;
		height: 1em;
		vertical-align: middle;
	}

	.lint-card .lint-message {
		margin: 0;
		font-size: var(--f-sm);

		> p {
			margin: 0;

			> code {
				padding: var(--p-xs);
				background-color: var(--bg-2);
				border-radius: var(--r-sm);
			}
		}
	}
</style>
