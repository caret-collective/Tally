---
import Icon from '@components/ui/Icon.astro';
import { getLocale, getLocaleMessages } from '@i18n/index.ts';
import { BookAlert, X } from '@lucide/astro';
import LintCard from '../LintCard/LintCard.astro';
import { ID } from './lint-popover.ts';
import LintPopover from './LintPopover.tsx';

const msg = getLocaleMessages(getLocale(Astro)).lint;
---

<div id={ID.lintPopoverAnchor} aria-hidden="true"></div>
<aside id={ID.lintPopover} popover role="dialog">
	<LintCard id={ID.lintPopoverCard}>
		<LintPopover closeLabel={msg.close.label} client:load>
			<Icon icon={BookAlert} slot="lint-icon" />
			<Icon icon={X} slot="close-icon" />
		</LintPopover>
	</LintCard>
</aside>

<style is:global>
	#lintPopoverAnchor {
		position: absolute;
		anchor-name: --lint-popover-anchor;
		transition-duration: var(--d-md);
		transition-property: top, left;
	}

	#lintPopover[popover] {
		position: absolute;
		position-area: block-end;
		position-anchor: --lint-popover-anchor;
		position-try-fallbacks:
			block-end inline-start,
			block-end inline-end;
		margin: var(--p-sm);
		padding: 0;
		background-color: transparent;
		border: 0;
		opacity: 0;
		transition-duration: var(--d-md);
		transition-property: display, opacity;
		transition-behavior: allow-discrete;
	}

	#lintPopover[popover]:popover-open {
		opacity: 1;
	}

	@starting-style {
		#lintPopover[popover]:popover-open {
			opacity: 0;
		}
	}

	#lintPopover .io-group {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: space-between;
		background-color: var(--bg-1);
		border-radius: var(--r-md);
		overflow: hidden;
	}

	#lintPopover .button {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		gap: var(--p-sm);
		flex-grow: 1;
		padding: var(--p-sm);
		color: var(--fg);
		border: none;
		border-radius: inherit;
		white-space: nowrap;
		cursor: pointer;
		transition-duration: var(--d-md);
		background-color: var(--bg-2);
		box-shadow: initial;

		&:hover {
			background-color: var(--bg-3);
			box-shadow: var(--s-box-md);
		}

		&:active {
			background-color: var(--bg-1);
			box-shadow: initial;
		}
	}
</style>
